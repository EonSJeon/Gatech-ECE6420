        pd=300n ld=105n ls=105n m=1
M3 (VinNode net10 0 0) NMOS_VTH w=10u l=50n as=9.45e-15 ad=9.45e-15 \
        ps=300n pd=300n ld=105n ls=105n m=1
M1 (Vout net2 VinNode 0) NMOS_VTH w=50.54906934u l=50n as=5.3076522807e-12 ad=5.3076522807e-12 ps=5.075906934e-05 pd=5.075906934e-05 ld=105n ls=105n m=1

